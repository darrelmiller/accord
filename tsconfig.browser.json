{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "dist/browser",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["ui/**/*.ts", "shared/**/*.ts"]
}
